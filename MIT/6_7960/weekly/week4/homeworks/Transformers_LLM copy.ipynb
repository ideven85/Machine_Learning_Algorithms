    "# a utility for calculating running average\n",
    "class AverageMeter:\n",
    "    def __init__(self):\n",
    "        self.num = 0\n",
    "        self.tot = 0\n",
    "\n",
    "    def update(self, val: float, sz: float):\n",
    "        self.num += val * sz\n",
    "        self.tot += sz\n",
    "\n",
    "    def calculate(self) -> float:\n",
    "        return self.num / self.tot\n",
    "\n",
    "\n",
    "def averager(func):\n",
    "    num = 0\n",
    "    total = 0\n",
    "    # val = 0.0\n",
    "\n",
    "    @wraps(func)\n",
    "    def inner(val, sz):\n",
    "        nonlocal num\n",
    "        nonlocal total\n",
    "        num += val * sz\n",
    "        total += sz\n",
    "        print(num, total, num / total)\n",
    "        return num, total, num / total\n",
    "\n",
    "    return inner"
   ]
